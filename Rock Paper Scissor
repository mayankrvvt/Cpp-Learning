#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {

    int userChoice;
    int computerChoice;

    srand(time(0));

    cout << "===== ROCK PAPER SCISSORS =====" << endl;

    cout << "\n1. Rock" << endl;
    cout << "2. Paper" << endl;
    cout << "3. Scissors" << endl;

    cout << "\nEnter your choice: ";
    cin >> userChoice;

    // Computer chooses randomly
    computerChoice = rand() % 3 + 1;

    cout << "\nYou chose: ";

    switch (userChoice) {
        case 1:
            cout << "Rock";
            break;

        case 2:
            cout << "Paper";
            break;

        case 3:
            cout << "Scissors";
            break;

        default:
            cout << "Invalid choice!";
            return 0;
    }

    cout << "\nComputer chose: ";

    switch (computerChoice) {
        case 1:
            cout << "Rock";
            break;

        case 2:
            cout << "Paper";
            break;

        case 3:
            cout << "Scissors";
            break;
    }

    cout << "\n\n";

    // Decide winner
    if (userChoice == computerChoice) {
        cout << "It's a DRAW!" << endl;
    }
    else if (
        (userChoice == 1 && computerChoice == 3) ||
        (userChoice == 2 && computerChoice == 1) ||
        (userChoice == 3 && computerChoice == 2)
    ) {
        cout << "YOU WIN! 🎉" << endl;
    }
    else {
        cout << "COMPUTER WINS!" << endl;
    }

    return 0;
}
